#usda 1.0
(
    defaultPrim = "Galbot_Zero"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Galbot_Zero"
{
    def "chassis" (
        prepend payload = @../../components/Chassis/chassis.usda@
        delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI", "NewtonArticulationRootAPI"]
        variants = {
            string Sensor = "sensors"
        }
    )
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.1045, 0, -0.1504)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "base_link"
        {
            def PhysicsFixedJoint "AssemblerFixedJoint"
            {
                rel physics:body0 = </Galbot_Zero/base_link>
                rel physics:body1 = </Galbot_Zero/chassis/base_link>
                point3f physics:localPos0 = (0.1045, 0, -0.1504)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

        over "Graphs"
        {
            over "differential_controller"
            {
                over "ArticulationController"
                {
                    custom token[] inputs:jointNames = ["left_wheel_joint", "right_wheel_joint"]
                    custom rel inputs:targetPrim = </Galbot_Zero> (
                        customData = {
                            dictionary omni = {
                                dictionary graph = {
                                    string relType = "target"
                                }
                            }
                        }
                    )
                }
            }

            over "ROS_Odometry"
            {
                over "ComputeOdometry"
                {
                    custom rel inputs:chassisPrim = </Galbot_Zero> (
                        customData = {
                            dictionary omni = {
                                dictionary graph = {
                                    string relType = "target"
                                }
                            }
                        }
                    )
                }
            }
        }
    }
}
