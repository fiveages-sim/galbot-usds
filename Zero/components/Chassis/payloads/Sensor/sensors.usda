#usda 1.0
(
    defaultPrim = "chassis"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "chassis"
{
    over "base_link"
    {
        over "hexman_chassis_base_link"
        {
            over "hexman_chassis_lidar_link"
            {
                def "lidar" (
                    prepend payload = @../../../chassis/lidar.usda@
                )
                {
                    quatf xformOp:orient = (0.70710677, -0.70710677, 0, 0)
                    double xformOp:rotateX:unitsResolve = 90
                    float3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:scale:unitsResolve = (0.01, 0.01, 0.01)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:rotateX:unitsResolve", "xformOp:scale:unitsResolve"]
                }

                def OmniLidar "Example_Rotary_2D" (
                    prepend references = @https://omniverse-content-staging.s3-us-west-2.amazonaws.com/Assets/Isaac/6.0/Isaac/Sensors/NVIDIA/Example_Rotary_2D.usda@
                )
                {
                    float omni:sensor:Core:nearRangeM = 0.1
                    bool omni:sensor:Core:skipDroppingInvalidPoints = 1
                    float omni:sensor:Core:validEndAzimuthDeg = 180
                    float omni:sensor:Core:validStartAzimuthDeg = 0
                    quatd xformOp:orient = (0.7071067811865476, 0, 0, 0.7071067811865475)
                    double3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0.06)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                }
            }
        }
    }
}
