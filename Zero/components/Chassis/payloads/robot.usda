        </chassis/joints/caster_1_joint>,
        </chassis/joints/caster_wheel_1_joint>,
        </chassis/joints/caster_2_joint>,
        </chassis/joints/caster_wheel_2_joint>,
        </chassis/joints/caster_3_joint>,
        </chassis/joints/caster_wheel_3_joint>,
        </chassis/joints/caster_4_joint>,
        </chassis/joints/caster_wheel_4_joint>,
        </chassis/joints/left_wheel_joint>,
        </chassis/joints/right_wheel_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
